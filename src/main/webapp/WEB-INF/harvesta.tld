<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_1.xsd"
        version="3.1">
    <tlib-version>1.0</tlib-version>
    <short-name>h</short-name>
    <uri>https://harvesta.app/functions</uri>

    <function>
        <name>date</name>
        <function-class>com.harvesta.web.Format</function-class>
        <function-signature>java.lang.String date(java.lang.Object)</function-signature>
    </function>

    <function>
        <name>number</name>
        <function-class>com.harvesta.web.Format</function-class>
        <function-signature>java.lang.String number(java.lang.Object)</function-signature>
    </function>

    <function>
        <name>money</name>
        <function-class>com.harvesta.web.Format</function-class>
        <function-signature>java.lang.String money(java.lang.Object)</function-signature>
    </function>

    <function>
        <name>e</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String e(java.lang.Object)</function-signature>
    </function>

    <function>
        <name>initials</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String initials(java.lang.String)</function-signature>
    </function>

    <function>
        <name>statusBadge</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String statusBadge(java.lang.String)</function-signature>
    </function>

    <function>
        <name>label</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String label(java.lang.String)</function-signature>
    </function>

    <function>
        <name>icon</name>
        <function-class>com.harvesta.web.Fn</function-class>
        <function-signature>java.lang.String icon(java.lang.String)</function-signature>
    </function>
</taglib>
